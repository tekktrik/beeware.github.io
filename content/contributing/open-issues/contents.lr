_model: page-open-issues
---
sort_key: 5
---
title: Open Issues
---
summary: Open issues across all the sub-projects
---
extra_head:
<style>
    .badge-issue-label {
        background-color: rgb(52, 58, 64)
    }
</style>
---
extra_script:
<script>
    // Trigger on dropdown or checkbox change
    function issueFilter() {
            
        // Get the label class to filter
        let label_class = document.getElementById("label-select").value;

        // Get all the issues and make a copy to edit
        let all_issues = Array.from(document.querySelectorAll(".issue-item"));
        var to_show = all_issues.slice();
        
        // Select only requested label
        if (label_class !== "show-all") {
            to_show = to_show.filter(issue => {return issue.classList.contains(label_class)});
        }

        // Filter by good first issues as well if requested
        if (document.getElementById("good-first-issue-select").checked) {
            to_show = to_show.filter(issue => {return issue.classList.contains("good-first-issue")});
        }

        // Show only the selected issues
        all_issues.forEach(issue => {
            let display_state = to_show.includes(issue);
            issue.hidden = !display_state;
        })
    }

    // Add the function as an event listener to the form elements
    document.querySelectorAll(".filter-trigger").forEach(element => {
        element.addEventListener("change", issueFilter);
    })

</script>
---
hide_from_index: yes
---
body:
<div class="container">
    <form>
        <div class="form-check issue-checkbox">
            <input class="form-check-input filter-trigger" id="good-first-issue-select" type="checkbox" value="gfi">
            <label class="form-check-label" for="good-first-issue-select">
                Show only "Good First Issues"
            </label>
        </div>
        <h3>Show issues labeled as:</h3>
        <div>
            <select class="form-select btn btn-primary btn-large filter-trigger" id="label-select">
                <option value="show-all">Show all issues</option>
                <option value="android">android</option>
                <option value="awaiting-details">awaiting details</option>
                <option value="bug">bug</option>
                <option value="documentation">documentation</option>
                <option value="enhancement">enhancement</option>
                <option value="iOS">iOS</option>
                <option value="linux">linux</option>
                <option value="macOS">macOS</option>
                <option value="not-quite-right">not quite right</option>
                <option value="web">web</option>
                <option value="windows">windows</option>
                
            </select>
        </div>
    </form>
</div>

