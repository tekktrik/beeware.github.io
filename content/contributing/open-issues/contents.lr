_model: page-open-issues
---
sort_key: 5
---
title: Open Issues
---
summary: Open issues across all the sub-projects
---
extra_head:
<style>
    .badge-issue-label, #label-select {
        background-color: rgb(61, 107, 221)
    }
</style>
---
extra_script:
<script>
    // Trigger on dropdown or checkbox change
    $( "#label-select, #good-first-issue-select" ).on( "change", function() {
        // Get the label class to filter
        let label_class = "." + $( "#label-select" ).val()

        // Hide all the issues to start
        $(".issue-item").hide();

        // Select all issues as candidates by default
        var to_show = $(".issue-item");

        // If "Show All" is not selected, select only requested label
        if (label_class !== ".show-all") {
            to_show = to_show.filter(label_class);
        }

        // Filter by good first issues as well if requested
        if ( $( "#good-first-issue-select:checked" ).val() === "gfi") {
            to_show = to_show.filter(".good-first-issue");
        }

        // Show the selected issues
        to_show.show();
    } );
</script>
---
hide_from_index: yes
---
body:
<h3>Show issues labeled as:</h3>
<div class="container">
    <form>
        <div>
            <select class="form-select btn btn-primary" id="label-select">
                <option value="show-all">Show all issues</option>
                {% for label in labels -%}
                {%- if label != "good first issue" -%}
                <option value="{{ label | replace(" ", "-") }}">{{ label }}</option>
                {% endif -%}
                {%- endfor %}
            </select>
        </div>
        <br>
        <div class="form-check issue-checkbox">
            <input class="form-check-input" id="good-first-issue-select" type="checkbox" value="gfi">
            <label class="form-check-label" for="good-first-issue-select">
                Show only "good first issues"
            </label>
        </div>
    </form>
</div>

{% for project, issues in projects.items() -%}
<h2>{{ project }}</h2>

<ul>
{% for issue in issues -%}
<li class="issue-item {% for label in issue.labels %}{{ label | replace(" ", "-")}} {% endfor %}"><a href="{{ issue.url }}">{{ issue.title }}</a> {% for label in issue.labels %}<span class="badge badge-pill badge-issue-label">{{ label }}</span> {% endfor %}</li>
{% endfor -%}
</ul>

{% endfor %}
