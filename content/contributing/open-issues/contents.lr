_model: page-jinja
---
sort_key: 5
---
title: Open Issues
---
summary: Open issues across all the sub-projects
---
hide_from_index: yes
---
body:
{% for project, issues in projects.items() -%}
<h2>{{ project }}</h2>

<ul>
{% for issue in issues -%}
<li class="{% for label in issue.labels %}{{ label }} {% endfor %}"><a href="{{ issue.url }}">{{ issue.title }}</a> {% for label in issue.labels %}<span class="badge badge-pill badge-secondary">{{ label }}</span> {% endfor %}</li>
{% endfor -%}
</ul>

{% endfor %}
